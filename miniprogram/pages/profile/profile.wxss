@import "../../styles/common.wxss";
.profile-hero { display: flex; align-items: center; gap: 24rpx; padding: 64rpx 42rpx 44rpx; background: #263a32; color: #fffdf8; }
.seal { display: grid; place-items: center; width: 92rpx; height: 92rpx; border: 1px solid #e8c991; color: #e8c991; font-family: serif; font-size: 42rpx; transform: rotate(-4deg); }
.profile-name { display: block; font-family: serif; font-size: 40rpx; }
.profile-sub { display: block; margin-top: 9rpx; color: rgba(255,253,248,.65); font-size: 21rpx; }
.stats { display: grid; grid-template-columns: 1fr 1fr; margin: 18rpx 0; padding: 30rpx 42rpx; background: #fffdf8; }
.stats view { display: flex; flex-direction: column; gap: 8rpx; }
.stats view + view { border-left: 1px solid rgba(30,36,32,.12); padding-left: 32rpx; }
.stats text:first-child { font-family: serif; font-size: 44rpx; }
.stats text:last-child { color: #77756d; font-size: 21rpx; }
.profile-section { margin-top: 18rpx; padding: 32rpx 42rpx; background: #fffdf8; }
.section-label { display: block; color: #a93f2d; font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx; }
.profile-link { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0 16rpx; border-bottom: 1px solid rgba(30,36,32,.1); font-size: 26rpx; }
.profile-link + .profile-link { padding-top: 24rpx; border-bottom: 0; }
.profile-link text:last-child { color: #a93f2d; font-size: 34rpx; }
.about-title { display: block; margin-top: 24rpx; font-family: serif; font-size: 36rpx; }
.about-copy { display: block; margin-top: 12rpx; color: #77756d; font-size: 23rpx; line-height: 1.8; }
.about-api { display: block; margin-top: 20rpx; color: #aaa59a; font-size: 18rpx; word-break: break-all; }
