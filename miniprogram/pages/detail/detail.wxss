@import "../../styles/common.wxss";
.detail-page { padding-bottom: 48rpx; }
.loading { min-height: 60vh; display: flex; align-items: center; justify-content: center; color: #77756d; font-size: 26rpx; }
.gallery { width: 100%; height: 540rpx; }
.gallery image { width: 100%; height: 100%; }
.detail-intro { padding: 34rpx 42rpx 26rpx; background: #fffdf8; }
.detail-meta { display: flex; gap: 14rpx; color: #a93f2d; font-size: 20rpx; }
.detail-title { display: block; margin-top: 15rpx; font-family: serif; font-size: 56rpx; }
.detail-tagline { display: block; margin-top: 10rpx; color: #77756d; font-size: 24rpx; }
.action-row { display: flex; gap: 18rpx; margin-top: 28rpx; }
.action-row button { flex: 1; height: 72rpx; margin: 0; border-radius: 2rpx; font-size: 24rpx; }
.bookmark-button { border: 1px solid #a93f2d; background: transparent; color: #a93f2d; }
.bookmark-button.active { background: #a93f2d; color: white; }
.map-button { border: 1px solid rgba(30,36,32,.18); background: transparent; color: #1e2420; }
.detail-section { margin-top: 18rpx; padding: 34rpx 42rpx; background: #fffdf8; }
.section-label { display: block; color: #a93f2d; font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx; }
.detail-text { display: block; margin-top: 17rpx; color: #434840; font-family: serif; font-size: 27rpx; line-height: 1.95; }
.split { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16rpx; }
.detail-value { display: block; margin-top: 12rpx; font-size: 23rpx; line-height: 1.5; }
.route { margin-top: 22rpx; display: flex; flex-wrap: wrap; gap: 14rpx; }
.route-item { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 16rpx; background: #f4f0e7; color: #434840; font-size: 23rpx; }
.route-item text:first-child { color: #a93f2d; font-weight: 700; }
.tip { display: flex; gap: 12rpx; margin-top: 16rpx; color: #434840; font-size: 24rpx; line-height: 1.7; }
.tip text:first-child { color: #a93f2d; font-size: 30rpx; }
.plan-box { margin: 18rpx 42rpx 0; padding: 28rpx; background: #263a32; color: #fffdf8; }
.plan-title { display: block; font-family: serif; font-size: 31rpx; }
.plan-box .subtle { display: block; margin-top: 9rpx; color: rgba(255,253,248,.68); font-size: 21rpx; }
.date-picker { margin-top: 22rpx; padding: 18rpx; border: 1px solid rgba(255,255,255,.35); color: #e8c991; font-size: 23rpx; }
.plan-button { width: 100%; height: 72rpx; margin: 18rpx 0 0; border: 0; border-radius: 2rpx; background: #a93f2d; color: white; font-size: 25rpx; }
