@import "../../styles/common.wxss";
.page { padding-bottom: 36rpx; }
.loading, .error-panel { min-height: 70vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28rpx; color: #77756d; font-size: 28rpx; }
.error-panel button { margin: 0; border: 1px solid #a93f2d; border-radius: 4rpx; background: transparent; color: #a93f2d; font-size: 26rpx; }
.hero { position: relative; height: 690rpx; overflow: hidden; color: #fffdf8; }
.hero-image { width: 100%; height: 100%; }
.hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,16,12,.1) 15%, rgba(8,16,12,.83) 100%); }
.hero-copy { position: absolute; left: 46rpx; right: 42rpx; bottom: 62rpx; display: flex; flex-direction: column; align-items: flex-start; }
.eyebrow { color: #b54832; font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; }
.hero .eyebrow { color: #e8c991; }
.hero-title { margin-top: 18rpx; font-family: serif; font-size: 92rpx; line-height: 1; }
.hero-title-accent { color: #f0dcb7; }
.hero-desc { margin-top: 28rpx; font-family: serif; font-size: 28rpx; line-height: 1.8; }
.hero-link { margin-top: 26rpx; padding-bottom: 12rpx; border-bottom: 1px solid rgba(255,255,255,.6); font-size: 25rpx; font-weight: 700; }
.hero-link text { margin-left: 40rpx; font-size: 30rpx; }
.intro-row { display: flex; align-items: flex-end; justify-content: space-between; padding: 54rpx 42rpx 28rpx; }
.section-title { display: block; margin-top: 12rpx; font-family: serif; font-size: 42rpx; }
.section-more { color: #a93f2d; font-size: 23rpx; }
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin: 0 42rpx 38rpx; }
.quick-item { padding: 24rpx; border: 1px solid rgba(30,36,32,.12); background: #fffdf8; display: grid; grid-template-columns: 54rpx 1fr; align-items: center; column-gap: 16rpx; }
.quick-icon { grid-row: span 2; display: grid; place-items: center; width: 54rpx; height: 54rpx; border-radius: 50%; background: rgba(169,63,45,.1); color: #a93f2d; font-size: 28rpx; }
.quick-item > text:nth-child(2) { font-weight: 700; font-size: 27rpx; }
.quick-note { color: #77756d; font-size: 21rpx; }
.spot-scroll { width: 100%; white-space: nowrap; }
.spot-row { display: inline-flex; gap: 22rpx; padding: 0 42rpx 8rpx; }
.spot-card { width: 330rpx; overflow: hidden; background: #fffdf8; box-shadow: 0 10rpx 30rpx rgba(30,25,18,.08); }
.spot-card image { width: 330rpx; height: 230rpx; }
.spot-card-body { padding: 22rpx; }
.spot-city { display: block; color: #a93f2d; font-size: 20rpx; }
.spot-name { display: block; margin-top: 10rpx; font-family: serif; font-size: 34rpx; }
.spot-tagline { display: block; margin-top: 8rpx; overflow: hidden; color: #77756d; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.culture-band { margin: 54rpx 42rpx 0; padding: 38rpx 32rpx; background: #263a32; color: #fffdf8; }
.culture-band .eyebrow { color: #e8c991; }
.culture-title { display: block; margin-top: 16rpx; font-family: serif; font-size: 42rpx; }
.culture-copy { display: block; margin-top: 18rpx; color: rgba(255,253,248,.72); font-size: 24rpx; line-height: 1.8; }
